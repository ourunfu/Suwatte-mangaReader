{
  "name": "copymanga-suwatte-source",
  "version": "1.0.1",
  "private": true,
  "description": "Unofficial CopyManga manga source for Suwatte (experimental)",
  "scripts": {
    "build": "suwatte build",
    "serve": "suwatte serve",
    "check": "tsc --noEmit",
    "test": "node --test tests/smoke.test.cjs tests/install-protocol.test.cjs",
    "test:bundle": "node --test tests/compiled-bundle.test.cjs",
    "test:published": "node scripts/verify-published.cjs"
  },
  "suwatte": {
    "listName": "CopyManga for Suwatte (Unofficial)"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@suwatte/toolchain": "1.0.0",
    "@types/crypto-js": "^4.2.2",
    "typescript": "^5.5.4"
  }
}
